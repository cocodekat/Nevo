_main() {
    num a = 1;
    num b = 2;

    if a = 1 && b = 2 { print("symbol-and"); }
    if a = 0 || b = 2 { print("symbol-or"); }
    if a = 1 and b = 2 { print("word-and"); }
    if a = 0 or b = 2 { print("word-or"); }

    num value = rand(1, 3);
    if value >= 1 && value <= 3 { print("rand-in-range"); }
}
