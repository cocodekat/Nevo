// Nevo v1.4 feature showcase
// Build from the release v1.4 directory:
//   ./run.sh examples/all_features.n -o build/all-features
// Run:
//   ./build/all-features

#include "showcase_helpers.n"

// Compile-time function removal and redefinition.
num _version() {
    return 13;
}
rfunc(_version);
num _version() {
    return 14;
}

_main() {
    clear();
    print("========================================\n");
    print("        NEVO v1.4 DUNGEON TOUR          \n");
    print("========================================\n");

    // Text and range-validated numeric terminal input.
    global txt heroName = input("Hero name: ");
    num difficulty = input("Difficulty (1-3): ", 1, 3);

    txt paddedTitle = "  THE SHIFTING DUNGEON  ";
    txt title = paddedTitle.trim();
    txt routeText = "north,east,south,west";
    array route = routeText.split(",");
    txt firstDirection = route[0];
    txt chosenDirection = wheel("north", "east", "south", "west");
    bool secretDoor = maybe;
    print("Campaign: ");
    print(title);
    print(" (letters: ");
    print(title.length());
    print(", contains DUNGEON: ");
    print(title.contains("DUNGEON"));
    print(")\nFirst route step: ");
    print(firstDirection);
    print(" | wheel chose: ");
    print(chosenDirection);
    print("\n");
    if'nt secretDoor {
        print("The secret door decided not to exist today.\n");
    }

    // Explicit shared state. Ordinary declarations remain local.
    global num visits = 0;
    global bool gameRunning = true;
    global array partyHp = [12, 9, 7];
    global array roomDanger = [1, 3, 2, 5];
    global file sharedReport = createf("nevo-showcase-report.txt");
    file map = _loadMap();

    writef(sharedReport, "NEVO v1.4 EXPEDITION\nunnamed hero\nsummary pending\n");
    _updateSharedState();

    print("\nWelcome, ");
    print(heroName);
    print(". Compiler version: ");
    print(_version());
    print("\nMap lines: ");
    print(map.count(1));
    print(", rooms containing ROOM: ");
    print(map.count(map.filter("ROOM")));
    print(", word 'the': ");
    print(map.count(word("the")));
    print("\n\nFirst map entry:\n");
    print(map.line(1));
    print("\nEntries mentioning gold:\n");
    print(map.filter("gold"));

    // Runtime function replacement: hard mode triples treasure rewards.
    print("\nReward multiplier before replacement: ");
    print(_reward());
    if difficulty = 3 {
        rfunc(_reward);
        num _reward() {
            return 3;
        }
    }
    print("; active multiplier: ");
    print(_reward());
    print("\n");

    // Arrays, random numbers, for/while/loop, break, continue and sleep.
    num gold = 0;
    bool foundExit = false;
    for num room = 0; room < roomDanger.length(); room = room + 1 {
        if room = 1 && difficulty = 1 {
            print("Room 2 was safely bypassed.\n");
            continue;
        }

        num roll = rand(1, 6);
        num danger = roomDanger[room] + difficulty;
        print("Room ");
        print(room + 1);
        print(": roll=");
        print(roll);
        print(", danger=");
        print(danger);

        if roll >= danger || roll = 6 {
            num treasure = rand(1, 4) * _reward();
            gold += treasure;
            print(" -> treasure +");
            print(treasure);
        } else {
            partyHp[0] = partyHp[0] - danger;
            print(" -> damage ");
            print(danger);
        }
        print("\n");

        while partyHp[0] < 6 && partyHp[1] > 0 {
            partyHp[0] = partyHp[0] + 2;
            partyHp[1] = partyHp[1] - 1;
            print("  A potion restores 2 HP.\n");
        }

        if partyHp[0] <= 0 {
            gameRunning = false;
            print("  The party can go no farther.\n");
            break;
        }
        if room = 3 {
            foundExit = true;
        }
        sleep(15);
    }

    num countdown = 3;
    print("\nExit rune: ");
    loop 3 {
        print(countdown);
        print(" ");
        countdown -= 1;
    }
    print("OPEN!\n");

    // Both word forms and symbolic forms of boolean logic are valid.
    if gameRunning and foundExit {
        print("The expedition escaped.\n");
    } else if !gameRunning or partyHp[0] <= 0 {
        print("The dungeon won this time.\n");
    } else {
        print("The expedition remains unfinished.\n");
    }

    print("Rank: ");
    print(_rank(gold));
    print(" | Gold: ");
    print(gold);
    txt goldText = str(gold);
    print(" (as text: ");
    print(goldText);
    print(")");
    print(" | HP: ");
    print(partyHp[0]);
    print(" | Visits: ");
    print(visits);
    print("\n");

    // File-to-line, text-to-line, and file-to-file writes.
    writef(sharedReport.line(3), map.line(1));
    file copy = createf("nevo-showcase-map-copy.txt");
    writef(copy, map);
    writef(copy, map.line(4));
    print("Copied final map line: ");
    print(copy);
    print("\n");

    // Old explicit local spelling, compile-time variable removal, and reuse.
    scoped num chapter = 1;
    scoped txt marker = "A";
    print("Legacy local syntax: chapter ");
    print($chapter);
    print(marker);
    print("\n");
    rvar(chapter);
    num chapter = 2;
    print("Reused variable name after rvar(): ");
    print(chapter);
    print("\n");

    // A returning call resumes here; this helper also creates an implicit
    // compatibility global named legacyResult.
    _legacyAdd(3, 4);
    print("Ordinary call result: ");
    print(legacyResult);
    print("\n");

    // Choose 0 during a normal tour. The other choices demonstrate both
    // whole-program termination aliases.
    print("Press one key to sign the expedition log: ");
    txt signature = keypress();
    print(signature);
    print("\n");
    num stopMode = input("Stop demo (0=finish, 1=quit, 2=kaboom): ", 0, 2);
    if stopMode = 1 {
        quit();
    } else if stopMode = 2 {
        kaboom();
    }

    // Tail-call syntax intentionally ends _main; _finish does not return here.
    jump _finish;
}
